{
  "key": "sdxl_hires",
  "name": "Text to image with hires fix — SDXL family",
  "family": "sdxl",
  "kind": "txt2img",
  "description": "One pass at the base size, a latent upscale, then a second pass that invents the detail the upscale cannot. Slower than sdxl_txt2img and visibly better above 1 megapixel.",
  "roles": ["checkpoint"],
  "lora_mode": "model_and_clip",
  "lora_source": "1",
  "needs": ["LatentUpscaleBy"],
  "defaults": {
    "negative": "lowres, bad anatomy, bad hands, text, watermark, signature, jpeg artifacts, worst quality",
    "steps": 26,
    "cfg": 5.5,
    "sampler": "dpmpp_2m",
    "scheduler": "karras",
    "denoise": 1.0,
    "hires_scale": 1.5,
    "hires_denoise": 0.45
  },
  "graph": {
    "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "{{checkpoint}}"}},
    "2": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["1", 1], "text": "{{prompt}}"}},
    "3": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["1", 1], "text": "{{negative}}"}},
    "4": {"class_type": "EmptyLatentImage", "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": "{{batch_size}}"}},
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["1", 0],
        "positive": ["2", 0],
        "negative": ["3", 0],
        "latent_image": ["4", 0],
        "seed": "{{seed}}",
        "steps": "{{steps}}",
        "cfg": "{{cfg}}",
        "sampler_name": "{{sampler}}",
        "scheduler": "{{scheduler}}",
        "denoise": "{{denoise}}"
      }
    },
    "6": {"class_type": "LatentUpscaleBy", "inputs": {"samples": ["5", 0], "upscale_method": "nearest-exact", "scale_by": "{{hires_scale}}"}},
    "7": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["1", 0],
        "positive": ["2", 0],
        "negative": ["3", 0],
        "latent_image": ["6", 0],
        "seed": "{{seed2}}",
        "steps": "{{steps}}",
        "cfg": "{{cfg}}",
        "sampler_name": "{{sampler}}",
        "scheduler": "{{scheduler}}",
        "denoise": "{{hires_denoise}}"
      }
    },
    "8": {"class_type": "VAEDecode", "inputs": {"samples": ["7", 0], "vae": ["1", 2]}},
    "9": {"class_type": "SaveImage", "inputs": {"images": ["8", 0], "filename_prefix": "{{filename_prefix}}"}}
  }
}
