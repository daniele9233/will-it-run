{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Will It Run",
  "mainBinaryName": "WillItRun",
  "version": "0.1.0",
  "identifier": "app.willitrun.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Will It Run",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 700,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://127.0.0.1:*; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Will It Run",
    "category": "DeveloperTool",
    "shortDescription": "What AI team can this PC run?",
    "longDescription": "Will It Run analyzes your Windows PC, finds the strongest local AI models it can run, downloads them through LM Studio, benchmarks them and builds LangGraph AI teams that run locally.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "resources/willitrun-core/": "willitrun-core/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Will It Run"
      }
    }
  }
}
